<Activity mc:Ignorable="sap sap2010" x:Class="Main" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="12">
      <x:String>GlobalConstantsNamespace</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text</x:String>
      <x:String>System.Windows</x:String>
      <x:String>Newtonsoft.Json.Linq</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>System.Net.Http</AssemblyReference>
      <AssemblyReference>System.Windows.MessageBox</AssemblyReference>
      <AssemblyReference>Newtonsoft.Json</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Appliance Customer Service Robot" sap2010:WorkflowViewState.IdRef="Main_Sequence">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="customerText" />
      <Variable x:TypeArguments="x:String" Name="responseJson" />
      <Variable x:TypeArguments="x:String" Name="route" />
      <Variable x:TypeArguments="x:String" Name="decisionText" />
      <Variable x:TypeArguments="x:String" Name="vbCrLf" Default="[Environment.NewLine]" />
    </Sequence.Variables>

    <ui:InputDialog DisplayName="1 - Ask the customer" Label="Enter the customer's message:" Title="Customer Service Bot">
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[customerText]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>

    <ui:HttpClient DisplayName="2 - Call the AI orchestration webhook" EndPoint="[&quot;http://127.0.0.1:5000/classify?text=&quot; + System.Uri.EscapeDataString(customerText)]" Method="GET" TimeoutMS="30000">
      <ui:HttpClient.Result>
        <OutArgument x:TypeArguments="x:String">[responseJson]</OutArgument>
      </ui:HttpClient.Result>
    </ui:HttpClient>

    <Assign DisplayName="3 - Read the route">
      <Assign.To><OutArgument x:TypeArguments="x:String">[route]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;route&quot;).ToString]</InArgument></Assign.Value>
    </Assign>

    <Assign DisplayName="4 - Build the decision summary">
      <Assign.To><OutArgument x:TypeArguments="x:String">[decisionText]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[&quot;AI DECISION  —  Layers 1 + 2&quot; + vbCrLf + vbCrLf + &quot;Customer said:   &quot; + customerText + vbCrLf + vbCrLf + &quot;Route:           &quot; + route + vbCrLf + &quot;Intent:          &quot; + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;intent&quot;).ToString + vbCrLf + &quot;Confidence:      &quot; + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;confidence&quot;).ToString + vbCrLf + &quot;Reason:          &quot; + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;reason&quot;).ToString + vbCrLf + vbCrLf + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;reason_detail&quot;).ToString]</InArgument></Assign.Value>
    </Assign>

    <ui:MessageBox DisplayName="5 - Show what the AI decided" Caption="STEP 1 - Conversational AI" Text="[decisionText]" Buttons="Ok" />

    <If DisplayName="6 - Automate or escalate?" Condition="[route = &quot;AUTO_RESOLVE&quot;]">
      <If.Then>
        <ui:MessageBox DisplayName="Robot acts" Caption="STEP 2 - RPA execution" Text="[&quot;ROBOT WILL ACT&quot; + vbCrLf + vbCrLf + &quot;Order:   &quot; + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;order_id&quot;).ToString + vbCrLf + &quot;Product: &quot; + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;order_product&quot;).ToString + vbCrLf + &quot;Action:  &quot; + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;action&quot;).ToString + vbCrLf + vbCrLf + &quot;The robot now performs this transaction on the CRM workbook.&quot;]" Buttons="Ok" />
      </If.Then>
      <If.Else>
        <ui:MessageBox DisplayName="Hand off to a person" Caption="STEP 2 - Human escalation" Text="[&quot;ESCALATED TO A HUMAN AGENT&quot; + vbCrLf + vbCrLf + &quot;Reason:  &quot; + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;reason&quot;).ToString + vbCrLf + vbCrLf + &quot;SUGGESTED RESOLUTION:&quot; + vbCrLf + Newtonsoft.Json.Linq.JObject.Parse(responseJson)(&quot;suggested_resolution&quot;).ToString + vbCrLf + vbCrLf + &quot;The agent receives a reasoned decision, not a transcript.&quot;]" Buttons="Ok" />
      </If.Else>
    </If>

  </Sequence>
</Activity>
